{
  "manifest_version": 3,
  "name": "NeuralAgent Browser",
  "version": "0.1.0",
  "description": "Lets your NeuralAgent autopilot open and read web pages in your own Chrome, in a tab group you can watch.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "NeuralAgent Browser",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["tabs", "tabGroups", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"]
}
