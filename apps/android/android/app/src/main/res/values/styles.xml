<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark like the app itself, so the system bars never flash white. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/na_bg</item>
        <item name="colorPrimaryDark">@color/na_bg</item>
        <item name="colorAccent">@color/na_accent</item>
        <item name="android:windowBackground">@color/na_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/na_bg</item>
        <item name="android:statusBarColor">@color/na_bg</item>
        <item name="android:navigationBarColor">@color/na_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/na_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_mark</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
