{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeuralAgent",
  "identifier": "dev.neuralhub.neuralagent",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "NeuralAgent",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "zoomHotkeysEnabled": false,
        "backgroundColor": "#080909"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:* https://agent.neuralhub.dev; img-src 'self' data: blob: asset: http://asset.localhost https://lh3.googleusercontent.com https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; frame-src http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "© Leandro Probst",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwMkI0MzU5REFCODU5OTgKUldTWVdiamFXVU1yTUhVVjBGNW5Oall1cTJITHlLaWIzN1pNQjZ1Z1pySlg2VjFHZndYWDhqd2cK",
      "endpoints": [
        "https://agent.neuralhub.dev/api/update/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
